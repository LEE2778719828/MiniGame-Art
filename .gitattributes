# Auto text/LF for common text files
* text=auto eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.uplugin text eol=lf
*.uproject text eol=lf
*.cs text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Unreal assets → Git LFS + lockable (team edit safety)
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable
*.uexp filter=lfs diff=lfs merge=lfs -text lockable
*.ubulk filter=lfs diff=lfs merge=lfs -text lockable
*.uptnl filter=lfs diff=lfs merge=lfs -text lockable

